# --- Contentful ---
# Space ID: Contentful dashboard > Settings > General settings
CONTENTFUL_SPACE_ID=

# Content Delivery API token (read-only, safe-ish, still keep private):
# Contentful dashboard > Settings > API keys > Content Delivery / Preview tokens
CONTENTFUL_CDA_TOKEN=

# Content Management API token (full read/write — NEVER expose to the browser):
# Contentful dashboard > Settings > API keys > Content management tokens > Generate personal token
CONTENTFUL_CMA_TOKEN=

# --- Site password (for your coaching staff) ---
SITE_PASSWORD=changeme
