---
const url = new URL(Astro.request.url);
const showError = url.searchParams.get("error") === "1";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GSIC Formation Sheet — Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&family=Inter:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #fdfdfd;
      font-family: "Inter", sans-serif;
    }
    .box {
      width: 320px;
      padding: 32px 28px;
      border: 1px solid rgba(26, 77, 156, 0.25);
      border-radius: 12px;
      box-shadow: 0 1px 3px rgba(26, 77, 156, 0.08);
      text-align: center;
    }
    h1 {
      font-family: "Oswald", sans-serif;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-size: 22px;
      margin: 0 0 6px;
      color: #000;
    }
    p.sub {
      font-size: 13px;
      color: rgba(0, 0, 0, 0.55);
      margin: 0 0 22px;
    }
    input[type="password"] {
      width: 100%;
      box-sizing: border-box;
      padding: 10px 12px;
      border: 1.5px solid rgba(26, 77, 156, 0.4);
      border-radius: 6px;
      font-size: 14px;
      margin-bottom: 14px;
    }
    button {
      width: 100%;
      padding: 10px;
      background: #1a4d9c;
      color: #fdfdfd;
      border: none;
      border-radius: 6px;
      font-family: "Oswald", sans-serif;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-size: 13px;
      cursor: pointer;
    }
    button:hover {
      background: #2760bd;
    }
    .error {
      color: #b00020;
      font-size: 13px;
      margin-bottom: 14px;
    }
  </style>
</head>
<body>
  <div class="box">
    <h1>GSIC Formation Sheet</h1>
    <p class="sub">Coaching staff access only</p>
    {showError && <p class="error">Wrong password — try again.</p>}
    <form method="POST" action="/api/login">
      <input type="password" name="password" placeholder="Password" autofocus required />
      <button type="submit">Enter</button>
    </form>
  </div>
</body>
</html>
