---
import "../styles/site.css";
import { getAllTeams } from "../lib/contentful";

const teams = await getAllTeams();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Scouting Reports</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <div class="top-bar"><a href="/api/logout">Log out</a></div>

  <header>
    <h1>Scouting Reports</h1>
    <p>Pick a team to open its formation sheet, or add a new opponent below.</p>
  </header>

  <main>
    <div class="cards" id="team-cards" style="margin-bottom:28px;">
      {teams.map((t) => (
        <a class="card team-card" href={`/teams/${t.slug}`}>
          <strong>{t.name}</strong>
          {t.description && <p class="team-desc">{t.description}</p>}
        </a>
      ))}

      {teams.length === 0 && (
        <p style="color:var(--chalk-dim); font-size:14px;">
          No teams yet — add your first opponent below.
        </p>
      )}
    </div>

    <div class="card" style="max-width:420px;">
      <strong style="display:block; margin-bottom:12px;">Add a new team</strong>
      <form id="add-team-form">
        <input
          type="text"
          id="team-name-input"
          placeholder="Team name (e.g. Augusta Eagles)"
          required
          style="width:100%; box-sizing:border-box; padding:10px 12px; border:1.5px solid rgba(26,77,156,.4); border-radius:6px; font-size:14px; margin-bottom:10px;"
        />
        <button
          type="submit"
          class="tool-action primary"
          style="width:100%; padding:10px; margin-left:0;"
        >
          Create Team
        </button>
        <div id="add-team-status" style="font-size:12px; margin-top:8px; color:var(--chalk-dim);"></div>
      </form>
    </div>
  </main>

  <footer>Add opponents as you scout them — each gets its own formation sheet.</footer>

  <style>
    .team-card{
      display:block;
      text-decoration:none;
      color:inherit;
      cursor:pointer;
    }
    .team-card strong{
      font-family:'Oswald',sans-serif;
      font-size:18px;
      text-transform:uppercase;
      letter-spacing:.5px;
    }
    .team-desc{
      font-size:13px;
      color:var(--chalk-dim);
      margin:8px 0 0;
    }
  </style>

  <script>
    const form = document.getElementById("add-team-form");
    const status = document.getElementById("add-team-status");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const nameInput = document.getElementById("team-name-input");
      // @ts-ignore — getElementById returns HTMLElement, but we know this one's an input
      const name = nameInput.value.trim();
      if (!name) return;

      status.textContent = "Creating…";
      status.style.color = "var(--chalk-dim)";
      try {
        const res = await fetch("/api/teams", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Failed to create team");
        window.location.href = `/teams/${data.slug}`;
      } catch (err) {
        status.textContent = "Error: " + err.message;
        status.style.color = "#b00020";
      }
    });
  </script>
</body>
</html>
